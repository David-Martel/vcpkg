{
  "id": "tools/kitware/cmake",
  "version": "3.31.5",
  "summary": "Kitware's cmake tool",
  "description": "CMake is an open-source, cross-platform family of tools designed to build, test and package software. CMake is used to control the software compilation process in the compiler environment of your choice.",
  "contacts": {
    "Jonatan Antoni": {
      "email": "jonatan.antoni@arm.com",
      "role": "publisher"
    },
    "Kitware": {
      "email": "kitware@kitware.com",
      "role": "originator"
    }
  },
  "demands": {
    "windows and x64": {
      "install": {
        "unzip": "https://cmake.org/files/v3.31/cmake-3.31.5-windows-x86_64.zip",
        "sha256": "d4d2d4b9ccd68dae975a066fcd42ea9807ef40f79ee6971923fd3788e7917585",
        "strip": 1
      }
    },
    "windows and x86": {
      "install": {
        "unzip": "https://cmake.org/files/v3.31/cmake-3.31.5-windows-i386.zip",
        "sha256": "26183bb30c7e338804570392426bc9abfe0e7bfc79bf27cd2d9ade9a5ba6a39f",
        "strip": 1
      }
    },
    "windows and arm64": {
      "install": {
        "unzip": "https://cmake.org/files/v3.31/cmake-3.31.5-windows-arm64.zip",
        "sha256": "a734e4e970fdaa4b5957157c059556f56ca5d655014cd4b5fd9194aaba316f31",
        "strip": 1
      }
    },
    "windows": {
      "exports": {
        "tools": {
          "cmake": "bin/cmake.exe",
          "cmake_gui": "bin/cmake-gui.exe",
          "ctest": "bin/ctest.exe"
        },
        "paths": {
          "PATH": "bin"
        }
      }
    },
    "osx": {
      "install": {
        "untar": "https://cmake.org/files/v3.31/cmake-3.31.5-macos-universal.tar.gz",
        "sha256": "cc8e3d9bef7eee70db52601a5ed60d221436a8def18388effdab0e7d0866f50d",
        "strip": 3
      }
    },
    "linux and x64": {
      "install": {
        "untar": "https://cmake.org/files/v3.31/cmake-3.31.5-linux-x86_64.tar.gz",
        "sha256": "2984e70515ff60c5e4a41922b5d715a8168a696a89721e3b114e36f453244f72",
        "strip": 1
      }
    },
    "linux and arm64": {
      "install": {
        "untar": "https://cmake.org/files/v3.31/cmake-3.31.5-linux-aarch64.tar.gz",
        "sha256": "eb92af175ea91e3706ff62484088c3a3774ef3e1a8c399111785dd5f47010164",
        "strip": 1
      }
    },
    "not windows": {
      "exports": {
        "tools": {
          "cmake": "bin/cmake",
          "cmake_gui": "bin/cmake-gui",
          "ctest": "bin/ctest"
        },
        "paths": {
          "PATH": "bin"
        }
      }
    }
  }
}
